<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- ESTATUS DE PRODUCTO: vistas, acción y menú                   -->
        <!-- ============================================================ -->
        <record id="view_product_estatus_form" model="ir.ui.view">
            <field name="name">product.estatus.form</field>
            <field name="model">product.estatus</field>
            <field name="arch" type="xml">
                <form string="Estatus de Producto">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_estatus_list" model="ir.ui.view">
            <field name="name">product.estatus.list</field>
            <field name="model">product.estatus</field>
            <field name="arch" type="xml">
                <list string="Estatus de Producto" editable="bottom">
                    <field name="name"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record id="action_product_estatus" model="ir.actions.act_window">
            <field name="name">Estatus de producto</field>
            <field name="res_model">product.estatus</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea un nuevo Estatus de producto
                </p>
            </field>
        </record>

        <menuitem id="menu_product_estatus"
                  name="Estatus de Producto"
                  parent="stock.menu_stock_config_settings"
                  action="action_product_estatus"
                  sequence="106"/>

        <!-- ============================================================ -->
        <!-- SUBESTATUS DE PRODUCTO: vistas, acción y menú                -->
        <!-- ============================================================ -->
        <record id="view_product_subestatus_form" model="ir.ui.view">
            <field name="name">product.subestatus.form</field>
            <field name="model">product.subestatus</field>
            <field name="arch" type="xml">
                <form string="Subestatus de Producto">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="subsequence"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_subestatus_list" model="ir.ui.view">
            <field name="name">product.subestatus.list</field>
            <field name="model">product.subestatus</field>
            <field name="arch" type="xml">
                <list string="Subestatus de Producto" editable="bottom">
                    <field name="name"/>
                    <field name="subsequence"/>
                </list>
            </field>
        </record>

        <record id="action_product_subestatus" model="ir.actions.act_window">
            <field name="name">Subestatus de producto</field>
            <field name="res_model">product.subestatus</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea un nuevo Subestatus de producto
                </p>
            </field>
        </record>

        <menuitem id="menu_product_subestatus"
                  name="Subestatus de Producto"
                  parent="stock.menu_stock_config_settings"
                  action="action_product_subestatus"
                  sequence="107"/>

    </data>
</odoo>
