<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════════════════════════════════
             CATEGORÍA del módulo (para agrupar en Ajustes > Usuarios)
        ══════════════════════════════════════════ -->
        <record id="module_category_wb_catalogo" model="ir.module.category">
            <field name="name">Catálogo WB</field>
            <field name="sequence">50</field>
        </record>

        <!-- ══════════════════════════════════════════
             GRUPO: Usuario Catálogo
             Acceso estándar a la app y vistas de catálogo.
        ══════════════════════════════════════════ -->
        <record id="group_wb_catalogo_user" model="res.groups">
            <field name="name">Usuario Catálogo</field>
            <field name="category_id" ref="module_category_wb_catalogo"/>
            <field name="comment">Acceso de lectura y navegación al catálogo de productos.</field>
        </record>

        <!-- ══════════════════════════════════════════
             GRUPO: Administrador Catálogo
             Hereda de Usuario. Puede editar campos custom
             como is_internal_consu, data_product_id, storable_base_id.
        ══════════════════════════════════════════ -->
        <record id="group_wb_catalogo_admin" model="res.groups">
            <field name="name">Administrador Catálogo</field>
            <field name="category_id" ref="module_category_wb_catalogo"/>
            <field name="implied_ids" eval="[(4, ref('group_wb_catalogo_user'))]"/>
            <field name="comment">Acceso completo al catálogo. Puede modificar clasificaciones y vínculos.</field>
        </record>

    </data>
</odoo>